{
  "name": "ctxlint",
  "version": "0.1.0",
  "description": "What are you actually sending the model? A local proxy that lints every request your app makes to Anthropic or OpenAI — wasted tokens, duplicated content, unused tools, prompt-cache misses, secrets, injection in tool results. Never modifies a request.",
  "keywords": [
    "llm",
    "anthropic",
    "openai",
    "claude",
    "context-window",
    "context-engineering",
    "prompt-caching",
    "tokens",
    "proxy",
    "lint",
    "ai-agents",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "author": "Rajan Aggarwal",
  "homepage": "https://github.com/rajanaggarwal11/ctxlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajanaggarwal11/ctxlint.git"
  },
  "bugs": {
    "url": "https://github.com/rajanaggarwal11/ctxlint/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ctxlint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "attw": "attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm",
    "publint": "publint"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
